# 1. HSLU & SWITCH EDU-ID LOGIN
HSLU_USERNAME=vorname.nachname@stud.hslu.ch
HSLU_PASSWORD=DeinPasswort
HSLU_TOTP_SECRET=DEIN_TOTP_SETUP_KEY_OHNE_LEERZEICHEN
HSLU_BACKUP_CODE_1=
HSLU_BACKUP_CODE_2=

# 2. GOOGLE WORKSPACE & KI (GEMINI)
GEMINI_API_KEY=AIzaSy...
GOOGLE_DRIVE_FOLDER_ID=

# 3. MICROSOFT 365 & ZOOM LOGIN (HSLU SSO FÜR CLOUD RECORDINGS)
HSLU_MS_EMAIL=vorname.nachname@stud.hslu.ch
HSLU_MS_PASSWORD=
HSLU_MS_TOTP_SECRET=
ZOOM_EMAIL=
ZOOM_PASSWORD=

# 4. DASHBOARD ZUGANG
DASHBOARD_PASS=
# Pflicht: ohne Passwort ist das Dashboard gesperrt. Benutzername: admin
# Standard 127.0.0.1 (nur lokal). Auf dem Server 0.0.0.0 + HTTPS-Reverse-Proxy.
DASHBOARD_HOST=127.0.0.1

