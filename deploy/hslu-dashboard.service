[Unit]
Description=HSLU KI-Studienassistent Dashboard
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/KiAgentHSLU
ExecStart=/opt/KiAgentHSLU/venv/bin/python dashboard.py
Restart=always
RestartSec=60
EnvironmentFile=/opt/KiAgentHSLU/.env

[Install]
WantedBy=multi-user.target
